{
  "name": "sera-event-introduction",
  "version": "1.0.0",
  "description": "Sera Protocol event film and GitHub Pages experience",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@remotion/cli": "4.0.526",
    "@remotion/player": "4.0.526",
    "@remotion/tailwind-v4": "4.0.526",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.526",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@remotion/eslint-config-flat": "4.0.526",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "^6.4.3"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets && vite build",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "studio": "remotion studio",
    "assets": "node scripts/generate-assets.mjs",
    "render": "npm run assets && remotion render src/index.ts SeraOverview public/sera-overview.mp4 --codec=h264",
    "render:still": "npm run assets && remotion still src/index.ts SeraOverview out/sera-poster.png --frame=90",
    "test": "playwright test",
    "check": "npm run lint && npm run build"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module"
}
